{
  "name": "priv-audit",
  "displayName": "PrivAudit",
  "description": "Automatic Privacy Audit during Code Authoring",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "priv-audit.analyze",
        "title": "Analyze Privacy Practices",
        "category": "PrivAudit",
        "icon": "$(shield)"
      },
      {
        "command": "priv-audit.showReport",
        "title": "Show Analysis Report",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.toggleRejected",
        "title": "Toggle Rejected Findings",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.toggleFindings",
        "title": "Toggle All Findings",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.resetManifest",
        "title": "Reset Findings Manifest",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.acceptFinding",
        "title": "Accept Finding",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.rejectFinding",
        "title": "Reject Finding",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.clearDecision",
        "title": "Clear Finding Decision",
        "category": "PrivAudit"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "priv-audit.analyze",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "priv-audit.acceptFinding",
          "when": "false"
        },
        {
          "command": "priv-audit.rejectFinding",
          "when": "false"
        },
        {
          "command": "priv-audit.clearDecision",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd --require ./out/test/stub/register.js \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "mocha": "11.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/prompt-tsx": "^0.4.0-alpha.8"
  }
}