{
  "name": "priv-audit",
  "displayName": "PrivAudit",
  "description": "Automatic Privacy Audit during Code Authoring",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "priv-audit.analyze",
        "title": "Analyze Privacy Practices",
        "category": "PrivAudit",
        "icon": "$(shield)"
      },
      {
        "command": "priv-audit.showReport",
        "title": "Show Analysis Report",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.toggleRejected",
        "title": "Toggle Rejected Findings",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.toggleFindings",
        "title": "Toggle All Findings",
        "category": "PrivAudit",
        "icon": "$(eye)"
      },
      {
        "command": "priv-audit.resetManifest",
        "title": "Reset Findings Manifest",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.acceptFinding",
        "title": "Accept Finding",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.rejectFinding",
        "title": "Reject Finding",
        "category": "PrivAudit"
      },
      {
        "command": "priv-audit.clearDecision",
        "title": "Clear Finding Decision",
        "category": "PrivAudit"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "priv-audit.analyze",
          "group": "navigation"
        },
        {
          "command": "priv-audit.toggleFindings",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "priv-audit.acceptFinding",
          "when": "false"
        },
        {
          "command": "priv-audit.rejectFinding",
          "when": "false"
        },
        {
          "command": "priv-audit.clearDecision",
          "when": "false"
        },
        {
          "command": "priv-audit.toggleRejected",
          "when": "privAudit.findingsVisible"
        }
      ]
    },
    "configuration": {
      "title": "PrivAudit",
      "properties": {
        "privAudit.model.vendor": {
          "type": "string",
          "default": "copilot",
          "markdownDescription": "Language-model vendor passed to `vscode.lm.selectChatModels`. `copilot` requires GitHub Copilot Chat."
        },
        "privAudit.model.family": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model family to request from the vendor (for example `gpt-4o`). Leave empty to use the vendor's first available model."
        },
        "privAudit.analysis.maxConcurrentRequests": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "Detection-rule requests in flight at once during an Analyze run. Each chunk of a file costs one request per rule, so higher values finish sooner but spend quota faster."
        },
        "privAudit.analysis.chunkOverlapLines": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 200,
          "markdownDescription": "Lines repeated between adjacent chunks of a large file, so a practice that straddles a boundary is intact in at least one chunk."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd --require ./out/test/stub/register.js \"out/test/**/*.test.js\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "mocha": "11.7.6",
    "prettier": "3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/prompt-tsx": "^0.4.0-alpha.8"
  }
}
